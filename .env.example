VK_TOKEN=your_vk_group_token_here
YADISK_TOKEN=your_yandex_disk_token_here

# Прокси для исходящих запросов (опционально; необходим на зарубежных
# серверах — VK API и его CDN недоступны напрямую). Формат:
# http://user:pass@host:port — тогда весь трафик бота идёт через него.
#HTTP_PROXY=
#HTTPS_PROXY=
#NO_PROXY=localhost,127.0.0.1
